{
    "compilerOptions": {
        "module": "commonjs",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "target": "esnext",
        "noImplicitAny": true,
        "moduleResolution": "bundler",
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,
        "allowJs": false,
        "strict": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "rootDir": "src",
        "outDir": "lib",
        "declarationDir": "lib"
    },
    "include": ["src"]
}
