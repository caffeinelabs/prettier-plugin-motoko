{
    "name": "prettier-plugin-motoko",
    "version": "1.0.0-beta.0",
    "description": "A code formatter for the Motoko smart contract language.",
    "type": "module",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "import": "./lib/index.js",
            "default": "./lib/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p . && node -e \"const fs=require('node:fs'),p=require('node:path'),out='lib/parser';fs.mkdirSync(out,{recursive:true});fs.copyFileSync('src/parser/tree-sitter-motoko.wasm',p.join(out,'tree-sitter-motoko.wasm'));fs.copyFileSync(require.resolve('web-tree-sitter/web-tree-sitter.wasm'),p.join(out,'web-tree-sitter.wasm'))\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc -p . --noEmit && tsc -p tsconfig.tools.json --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "gen:node-types": "node --experimental-strip-types tools/gen-node-types.ts",
        "gen:node-types:check": "node --experimental-strip-types tools/gen-node-types.ts --check",
        "package": "cd packages/mo-fmt && npm run package",
        "prepublishOnly": "npm run build"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=22"
        }
    },
    "devDependencies": {
        "@types/node": "^22.20.3",
        "fast-glob": "^3.2.11",
        "prettier": "^3.5.3",
        "tree-sitter-motoko": "0.2.0",
        "typescript": "^6.0.3",
        "vitest": "^3.2.7",
        "web-tree-sitter": "0.26.13"
    },
    "peerDependencies": {
        "prettier": "^3.0.0"
    },
    "files": [
        "src/**/*",
        "!src/**/*.js",
        "!src/**/*.js.map",
        "!src/**/*.d.ts",
        "!src/**/*.d.ts.map",
        "lib/**/*",
        "lib/parser/tree-sitter-motoko.wasm",
        "lib/parser/web-tree-sitter.wasm"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/caffeinelabs/prettier-plugin-motoko.git"
    },
    "author": "DFINITY Foundation (https://github.com/dfinity)",
    "license": "Apache-2.0",
    "bugs": {
        "url": "https://github.com/caffeinelabs/prettier-plugin-motoko/issues"
    },
    "homepage": "https://github.com/caffeinelabs/prettier-plugin-motoko#readme"
}
