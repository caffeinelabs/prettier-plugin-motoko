{
    "name": "prettier-plugin-motoko",
    "version": "1.0.0-beta.0",
    "description": "A code formatter for the Motoko smart contract language.",
    "type": "module",
    "main": "lib/index.js",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "import": "./lib/index.js",
            "default": "./lib/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p . && node tools/copy-wasm.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc -p . --noEmit && tsc -p tsconfig.tools.json",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "gen:node-types": "node --experimental-strip-types tools/gen-node-types.ts",
        "gen:node-types:check": "node --experimental-strip-types tools/gen-node-types.ts --check",
        "prepublishOnly": "npm run build"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=22"
        }
    },
    "devDependencies": {
        "@types/node": "^22.20.3",
        "prettier": "^3.5.3",
        "tree-sitter-motoko": "0.2.1",
        "typescript": "^6.0.3",
        "vitest": "^5.0.1"
    },
    "peerDependencies": {
        "prettier": "^3.0.0"
    },
    "files": [
        "lib/**/*"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/caffeinelabs/prettier-plugin-motoko.git"
    },
    "author": "DFINITY Foundation (https://github.com/dfinity)",
    "license": "Apache-2.0",
    "bugs": {
        "url": "https://github.com/caffeinelabs/prettier-plugin-motoko/issues"
    },
    "homepage": "https://github.com/caffeinelabs/prettier-plugin-motoko#readme",
    "types": "lib/index.d.ts",
    "dependencies": {
        "web-tree-sitter": "0.26.13"
    }
}
